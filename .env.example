COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
DB_USERNAME=gyeongjung
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 알림(docker-compose.alerting.yml)을 켤 때만 필요하다. 로컬은 dev 웹훅, 서버는 prod 웹훅
DISCORD_WEBHOOK_URL=
ENVIRONMENT_NAME=local
# 서버 밖 백업 복사(rclone 목적지). 비어 있으면 서버 안 백업만 한다. 서버 .env에만 채우고 저장소에는 올리지 않는다.
# 저장소가 정해지면 아래 주석을 풀어 채운다 (R2 예시이고 항목 이름은 저장소를 정한 뒤 #14에서 확인한다). 키는 업로드 전용으로 만든다.
OFFSITE_URL=
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# nginx 과부하 방어 한도(#31). 쓰기 요청(POST, PUT, PATCH, DELETE)만 IP별로 제한한다. 비워 두면 아래 기본값이다.
# 바꾸면 `docker compose up -d nginx`로 컨테이너를 다시 만들어야 반영된다. 근거는 docs/overload-protection.md
# LIMIT_WRITE_RATE=5      # IP당 초당 쓰기 요청 수 (넘기면 429)
# LIMIT_WRITE_BURST=20    # 순간적으로 더 받아 주는 쓰기 요청 수
# LIMIT_CONN_PER_IP=30    # IP당 동시에 처리 중인 요청 수 (넘기면 503)
# LIMIT_CONN_TOTAL=400    # 서버 전체 동시에 처리 중인 요청 수 (넘기면 503)
# DB 연결 풀 기본값(#31). worker가 사용하고, 비워 두면 아래 값이다. 근거는 docs/overload-protection.md
# DB_POOL_MAX_SIZE=5
# DB_CONNECTION_TIMEOUT_MS=3000
# 같은 서버의 다른 서비스가 9090을 쓰면 바꾼다. 서버에서는 9091을 쓴다(#14).
# PROMETHEUS_HOST_PORT=9090
