COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
DB_USERNAME=gyeongjung
DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 알림(docker-compose.alerting.yml)을 켤 때만 필요하다. 로컬은 dev 웹훅, 서버는 prod 웹훅
DISCORD_WEBHOOK_URL=
ENVIRONMENT_NAME=local
# 서버 밖 백업 복사(rclone 목적지). 비어 있으면 서버 안 백업만 한다. 서버 .env에만 채우고 저장소에는 올리지 않는다.
# 저장소가 정해지면 아래 주석을 풀어 채운다 (R2 예시이고 항목 이름은 저장소를 정한 뒤 #14에서 확인한다). 키는 업로드 전용으로 만든다.
OFFSITE_URL=
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
