<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
    "https://checkstyle.org/dtds/import_control_1_4.dtd">
<import-control pkg="com.gyeongjung">
    <!-- 새 모듈은 아래에 항목을 추가해야 한다. 항목이 없으면 모든 import가 막혀서 빌드가 실패한다 -->
    <allow pkg="^(?!com\.gyeongjung(\.|$)).*" regex="true"/>

    <!-- 루트 패키지(app)는 local-only라서 하위 모듈로 번지지 않는다. 각 모듈의 공개 API(루트 패키지 클래스)만 쓴다 -->
    <allow pkg="com.gyeongjung.shared" local-only="true"/>
    <disallow pkg="com\.gyeongjung\.(ops|collector)\.[a-z].*" regex="true" local-only="true"/>
    <allow pkg="com.gyeongjung.ops" local-only="true"/>
    <allow pkg="com.gyeongjung.collector" local-only="true"/>

    <subpackage name="shared">
        <allow pkg="com.gyeongjung.shared"/>
    </subpackage>

    <subpackage name="ops">
        <allow pkg="com.gyeongjung.ops"/>
        <allow pkg="com.gyeongjung.shared"/>
    </subpackage>

    <!-- 다른 모듈은 루트 패키지의 클래스만 쓴다. 소문자로 시작하는 하위 패키지는 내부용이라 먼저 막는다 -->
    <subpackage name="collector">
        <allow pkg="com.gyeongjung.collector"/>
        <allow pkg="com.gyeongjung.shared"/>
        <disallow pkg="com\.gyeongjung\.ops\.[a-z].*" regex="true"/>
        <allow pkg="com.gyeongjung.ops"/>
    </subpackage>
</import-control>
